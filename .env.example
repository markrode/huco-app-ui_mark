# Copy this file to .env and fill in your credentials.
# Variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle.

# ─── TMDB ────────────────────────────────────────────────────────────────────────────────
# Create a free account at https://www.themoviedb.org/ → Settings → API
EXPO_PUBLIC_TMDB_API_KEY=

# ─── Supabase ─────────────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com → Project Settings → API
# Then run supabase/schema.sql in the SQL Editor.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
